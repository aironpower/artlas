{
  "name": "@artlas/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "artlas-ingest": "./src/cli.ts"
  },
  "scripts": {
    "start": "tsx --env-file=../../.env src/cli.ts",
    "seed": "tsx src/build-seed.ts",
    "verify": "tsx src/verify-sources.ts",
    "estimate": "tsx src/estimate.ts",
    "check-db": "tsx --env-file=../../.env src/check-db.ts",
    "typecheck": "tsc --noEmit",
    "peek": "tsx --env-file=../../.env src/peek.ts",
    "audit": "tsx --env-file=../../.env src/audit/run.ts",
    "check-gate": "tsx src/check-gate.ts",
    "check-incremental": "tsx src/check-incremental.ts",
    "check-perf": "tsx --env-file=../../.env src/check-perf.ts",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "merge-movements": "tsx --env-file=../../.env src/merge-movements.ts",
    "promote": "tsx --env-file=../../.env src/promote.ts",
    "fill-images": "tsx --env-file=../../.env src/fill-images.ts",
    "fix-artists": "tsx --env-file=../../.env src/fix-artists.ts",
    "refresh": "tsx --env-file=../../.env src/refresh-counters.ts",
    "worker": "tsx --env-file=../../.env src/worker.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
