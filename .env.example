# PLANTILLA. Cópiala a .env y rellena ahí los valores reales:
#   cp .env.example .env
#
# Este fichero SÍ se sube al repositorio, así que nunca debe contener
# credenciales. El .env real está en .gitignore.

# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role, NO anon: la ingesta necesita saltarse las políticas RLS.
# Es una clave de administrador total sobre la base de datos.
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa a Postgres. SOLO para aplicar migraciones (npm run migrate):
# ni la ingesta ni la web la usan. Da más poder que la service_role key, que
# puede leer y escribir datos pero no cambiar el esquema.
#
# Cógela del panel: Connect > Session pooler > URI. NO uses la conexión directa
# (db.<ref>.supabase.co): solo resuelve por IPv6 y falla con ENOTFOUND en redes
# sin IPv6.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:CONTRASEÑA@aws-0-<región>.pooler.supabase.com:5432/postgres

# Identifícate ante Wikidata (si no, limitan el rate agresivamente)
WIKIDATA_USER_AGENT=Artlas/0.1 (https://github.com/tuusuario/artlas; tu@email.com)

# Harvard Art Museums — https://harvardartmuseums.org/collections/api
# Registro gratuito. AIC y Met no requieren clave.
HARVARD_API_KEY=

# --- App web ---
# anon key: pública por diseño, limitada por las políticas RLS del esquema.
# NO confundir con service_role, que salta toda la seguridad.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Panel de administración ---
# A dónde vuelve el enlace mágico del correo. Tiene que estar dado de alta en
# Supabase: Authentication > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3111
